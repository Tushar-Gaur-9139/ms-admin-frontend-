# Leave empty during local development to use the Vite proxy to Laravel.
# Set to the shared Laravel API origin when deploying, for example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Local Laravel server target for Vite's /api and /sanctum proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
